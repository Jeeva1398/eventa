{
  "name": "@jeeva1398/eventa",
  "version": "0.1.1",
  "description": "Offline AI assistant for Node.js developers: explain errors, review diffs, audit dependencies.",
  "type": "module",
  "bin": {
    "eventa": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "nodejs",
    "ai",
    "cli",
    "llm",
    "offline",
    "code-review",
    "ollama",
    "gguf"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeeva1398/eventa.git",
    "directory": "packages/cli"
  },
  "author": "Jeeva1398",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "homepage": "https://github.com/Jeeva1398/eventa#readme",
  "bugs": {
    "url": "https://github.com/Jeeva1398/eventa/issues"
  }
}
